# Development configuration. Never commit a filled-in .env.
# In production, secrets come from the vault, not from this file.

SHL_ENVIRONMENT=dev
# Issuing entity shown on the cover page of PDF reports.
SHL_REPORT_ORGANISATION=SOC

# Logical alias -> real Log Analytics workspace identifier.
# The model only sees the alias; the real identifier never leaves the middleware.
# Optional: the Sentinel workspace can also be entered from the Configuration screen
# (Subscription ID, resource group, name); this variable wins when set.
SHL_WORKSPACE_ALIASES={"soc-principal": "00000000-0000-0000-0000-000000000000"}

# Fixed-domain sources (VirusTotal, OTX, ThreatFox): they activate as soon as their key
# is present, here or in the Configuration screen. This list now only serves the keyless
# CIRCL source (www.circl.lu): adding it enables it.
SHL_TI_ALLOWED_DOMAINS=

# Demo mode: plugs simulated SIEMs in place of real ones (dev only).
# Every row is marked "simulation" and the frontend shows a banner. Only use it to
# demonstrate how the agent works without access to a SIEM.
# SHL_DEMO_SIEM=false

# Tokenization of internal identifiers (hosts, accounts, private IPs) before anything is
# sent to the model. On by default; the internal DNS suffixes declared below improve
# hostname detection in free text.
# SHL_TOKENIZATION__ENABLED=true

# Approved publishers for public report search (the "publisher reports" source).
# Example: cisa.gov,cert.ssi.gouv.fr,mandiant.com,unit42.paloaltonetworks.com
# Requires a search key, entered in the Configuration screen. Priority:
# - TAVILY_API_KEY (Tavily, full web index, free tier - recommended), then
# - BRAVE_SEARCH_API_KEY (Brave Search API, full web index, paid), then
# - SEARCH_API_KEY + SEARCH_ENGINE_ID (Google Programmable Search, limited to 50
#   domains since 2026).
SHL_TI_PUBLISHER_DOMAINS=

# Report search open to the whole web (HTTPS pages only). Relaxes the egress allow-list
# for the upstream phase only: only the campaign name goes out, every IOC cites its
# source page and goes through analyst validation. Have it approved by security.
# SHL_TI_OPEN_SEARCH=false

# Internal DNS suffixes, used by the egress anti-leak filter.
SHL_INTERNAL_HOSTNAME_SUFFIXES=corp.local,internal.example

# Google SecOps (Chronicle): everything is configured in the Configuration screen - the
# service account JSON key (SECOPS_SA_KEY, Chronicle API Viewer role) and the instance
# path (SECOPS_INSTANCE_PATH, SecOps console > SOC Profile > Instance ID). The regional
# endpoint is derived from the region in the path. The variables below are server fallbacks.
# SHL_SECOPS_INSTANCE_PATH=projects/<id>/locations/<region>/instances/<uuid>
# SHL_SECOPS_BASE_URL=

# LLM gateway (OpenAI-compatible interface).
SHL_GATEWAY_BASE_URL=
# Model identifiers on the gateway (exact list: GET /v1/models).
# Analysis/decision = the most capable model; queries = a fast model.
SHL_GATEWAY_MODEL_ANALYSIS=
SHL_GATEWAY_MODEL_QUERY=

# Anonymization model endpoint (local OpenAI-compatible model, semantic pass).
# Can be the same provider as the main gateway, a local model, or empty. The key is
# entered in the Configuration screen (ANONYMIZER_API_KEY), not here. Exact model
# identifier via scripts/list_anonymizer_models.py once the URL is set.
SHL_ANONYMIZER_BASE_URL=
SHL_ANONYMIZER_MODEL=local-anonymizer-model

# Semantic anonymization pass: after the deterministic layer, free-text fields go through
# the anonymization model, which catches the residue (names, loose identifiers).
# Fail-closed: if the model is unreachable, free-text fields are MASKED rather than
# sent in the clear. Set fail_closed=false for a less strict behaviour.
# SHL_SEMANTIC_ANONYMIZATION=true
# SHL_SEMANTIC_ANONYMIZATION_FAIL_CLOSED=true

# Prompt caching: marks the stable prompt prefix as cacheable so the re-sent context is
# not billed again on every iteration. Depends on the gateway's interface; set to false
# if the gateway rejects the markers.
SHL_GATEWAY_PROMPT_CACHING=true

SHL_DATABASE_URL=sqlite+aiosqlite:///./hunts.db

# Server log level. Outbound call failures (gateway, threat-intel sources) are logged
# at WARNING with their real cause, secrets excluded. Set DEBUG to trace every call.
# SHL_LOG_LEVEL=INFO

# Azure Key Vault. Empty = development mode (local encrypted store + .env).
# Set = every secret is read and written in the vault through the managed identity
# (`azure` extras required, Secrets User + Secrets Officer roles on the vault).
# SHL_KEY_VAULT_URL=https://example-vault.vault.azure.net

# Certificate authority for outbound calls, if a corporate proxy inspects TLS traffic
# (re-signs certificates). The bundle must contain the public roots AND the internal
# root:  cat "$(.venv/bin/python -m certifi)" internal-root.pem > bundle.pem
# Without it, an inspected domain (e.g. virustotal.com) is rejected as "unreachable".
# SHL_CA_BUNDLE=/path/to/bundle.pem

# Development-only secrets (SHL_SECRET_ prefix).
# EnvSecretProvider refuses to serve them outside SHL_ENVIRONMENT=dev.
SHL_SECRET_ENTRA_TENANT_ID=
SHL_SECRET_ENTRA_CLIENT_ID=
SHL_SECRET_ENTRA_CLIENT_SECRET=
SHL_SECRET_GATEWAY_API_KEY=
SHL_SECRET_VIRUSTOTAL_API_KEY=
SHL_SECRET_OTX_API_KEY=
SHL_SECRET_THREATFOX_API_KEY=
SHL_SECRET_SEARCH_API_KEY=
SHL_SECRET_SEARCH_ENGINE_ID=
