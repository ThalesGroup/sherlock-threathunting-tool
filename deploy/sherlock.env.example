# Production configuration for the platform (read by systemd: EnvironmentFile).
# Install as /etc/sherlock/sherlock.env, mode 640, owner root:sherlock.
# No API key here: keys are entered in the Configuration screen (encrypted store).

SHL_ENVIRONMENT=prod

# Server log level. Outbound call failures (gateway, threat-intel sources) are logged
# at WARNING with their real cause, secrets excluded. Set DEBUG to trace every call.
# SHL_LOG_LEVEL=INFO
SHL_REPORT_ORGANISATION=SOC

# Internal database and encrypted store, on a backed-up persistent volume.
SHL_DATABASE_URL=sqlite+aiosqlite:////var/lib/sherlock/hunts.db
SHL_SECRET_STORE_PATH=/var/lib/sherlock/.secrets.enc
# Master key of the encrypted store: generate once with
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and keep it only in this file (never in the repository). Losing this key means
# re-entering every API key in the Configuration screen.
SHL_SECRET_STORE_KEY=

# Internal LLM gateway (OpenAI-compatible interface) and model identifiers.
SHL_GATEWAY_BASE_URL=
SHL_GATEWAY_MODEL_ANALYSIS=
SHL_GATEWAY_MODEL_QUERY=
SHL_GATEWAY_PROMPT_CACHING=true

# Semantic anonymization (local model endpoint). The key is entered in Configuration.
SHL_ANONYMIZER_BASE_URL=
SHL_ANONYMIZER_MODEL=
SHL_SEMANTIC_ANONYMIZATION=true
SHL_SEMANTIC_ANONYMIZATION_FAIL_CLOSED=true

# Sentinel: logical alias -> Workspace ID (GUID) of the Log Analytics workspace. Optional:
# a single workspace can be entered from the Configuration screen (subscription, resource
# group, name); this variable serves multiple workspaces and wins when set.
# SHL_WORKSPACE_ALIASES={"soc-principal": "00000000-0000-0000-0000-000000000000"}

# Internal DNS suffixes (free-text host tokenization, egress anti-leak filter).
SHL_INTERNAL_HOSTNAME_SUFFIXES=

# Threat intel: keyless sources to enable, preferred publishers, open search.
SHL_TI_ALLOWED_DOMAINS=www.circl.lu
SHL_TI_PUBLISHER_DOMAINS=microsoft.com,cisa.gov,cert.ssi.gouv.fr,mandiant.com,unit42.paloaltonetworks.com,crowdstrike.com,welivesecurity.com,securelist.com,talosintelligence.com,fortinet.com,trendmicro.com,elastic.co
SHL_TI_OPEN_SEARCH=false

# Budget checkpoint: how long to wait for the analyst's decision (seconds, 0 = disabled).
SHL_BUDGET_PAUSE_TIMEOUT_SECONDS=600

# Internet egress (threat intel, cloud SIEM) through the corporate proxy; internal
# hosts (LLM gateway, anonymization endpoint) are reached directly.
HTTPS_PROXY=http://proxy.example.corp:8080
HTTP_PROXY=http://proxy.example.corp:8080
NO_PROXY=localhost,127.0.0.1,.corp.example
# CA bundle if outbound traffic is TLS-inspected (public roots + internal root).
SHL_CA_BUNDLE=/etc/sherlock/ca-bundle.pem

# Azure Key Vault (optional): setting the URL switches every secret to the vault
# through the VM's managed identity, with no other change.
# SHL_KEY_VAULT_URL=https://example-vault.vault.azure.net
